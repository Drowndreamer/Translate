<Window x:Class="Translate.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Translate" Width="900" Height="650" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterScreen" Icon="/Translate;component/Assets/translate.ico">
 <Grid Margin="30,24,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="42" Height="42" Background="{DynamicResource PrimaryBrush}" CornerRadius="9" VerticalAlignment="Center"><TextBlock Text="译" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="Translate" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="划词即译，专注阅读。" Style="{StaticResource Caption}"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="TranslateNav" Content="翻译" GroupName="Navigation" Style="{StaticResource Navigation}" Checked="TranslationPageSelected" IsChecked="True"/><RadioButton x:Name="SettingsNav" Content="设置" GroupName="Navigation" Style="{StaticResource Navigation}" Margin="6,0,0,0" Checked="SettingsPageSelected"/></StackPanel>
  </Grid>
  <Grid x:Name="TranslationPage" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="DirectionLabel" Text="自动识别 · 中英互译" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="ProviderLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}"/></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="原文" Style="{StaticResource Caption}"/><TextBox x:Name="InputBox" TextChanged="InputChanged" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="16" Padding="16" ToolTip="输入或粘贴需要翻译的中文或英文" AutomationProperties.Name="中文或英文原文"/></Grid>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="译文" Style="{StaticResource Caption}"/><TextBox x:Name="OutputBox" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="17" Padding="16" AutomationProperties.Name="翻译结果"/><TextBlock x:Name="OutputPlaceholder" Grid.Row="2" Text="译文会显示在这里" Style="{StaticResource Caption}" Margin="17,18" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid>
   </Grid>
   <Grid Grid.Row="3" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="TranslateButton" Content="翻译" Style="{StaticResource Primary}" MinWidth="94" Click="TranslateClicked"/><Button x:Name="CancelButton" Content="取消" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelClicked"/></StackPanel><Button x:Name="CopyButton" Content="复制译文" HorizontalAlignment="Right" IsEnabled="False" Click="CopyClicked"/></Grid>
  </Grid>
  <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="翻译服务" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,14,0,16"><RadioButton x:Name="DeepSeekRadio" Content="DeepSeek" GroupName="Provider" IsChecked="True" Checked="ProviderChanged"/><RadioButton x:Name="CustomRadio" Content="自定义兼容接口" GroupName="Provider" Margin="24,0,0,0" Checked="ProviderChanged"/></StackPanel>
    <TextBlock Text="API 地址" Margin="0,0,0,6"/><TextBox x:Name="BaseUrlBox" AutomationProperties.Name="API 地址"/>
    <TextBlock Text="模型名称" Margin="0,15,0,6"/><TextBox x:Name="ModelBox" AutomationProperties.Name="模型名称"/>
    <TextBlock Text="API Key" Margin="0,15,0,6"/><Grid><PasswordBox x:Name="KeyBox" AutomationProperties.Name="API Key"/><TextBox x:Name="VisibleKeyBox" Visibility="Collapsed" AutomationProperties.Name="API Key 明文"/></Grid><CheckBox x:Name="RevealKey" Content="显示 Key" Margin="0,8,0,0" Checked="RevealChanged" Unchecked="RevealChanged"/>
    <TextBlock Text="Key 仅保存在本机，并使用 Windows 账户加密保护。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource Primary}" Click="SaveClicked"/><Button x:Name="TestButton" Content="测试连接" Margin="10,0,0,0" Click="TestClicked"/></StackPanel>
   </StackPanel>
   <Border Grid.Column="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0"><StackPanel><TextBlock Text="右键划词" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="GestureEnabled" Content="启用长按右键翻译" Margin="0,18,0,0"/><TextBlock Text="长按时长" Margin="0,25,0,8"/><TextBlock x:Name="HoldLabel" Text="0.3 秒" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><Slider x:Name="HoldSlider" Minimum="0.2" Maximum="2" Value="0.3" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,10,0,0" ValueChanged="HoldChanged"/><Grid Margin="0,3,0,0"><TextBlock Text="0.2 秒" Style="{StaticResource Caption}"/><TextBlock Text="2 秒" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid><TextBlock Text="选中文字后，按住右键达到设定时长，即可查看翻译。短按右键仍打开原菜单。" Style="{StaticResource Caption}" Margin="0,22,0,0"/><Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,22,0,15"/><TextBlock Text="关闭窗口后继续在托盘运行。右键点击托盘图标可以退出。" Style="{StaticResource Caption}"/></StackPanel></Border>
  </Grid></ScrollViewer>
  <Grid Grid.Row="3" Margin="0,19,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Height="1" Background="{DynamicResource LineBrush}"/><TextBlock x:Name="StatusLabel" Grid.Row="1" Margin="0,10,0,0" Text="选中文字，按住右键 0.3 秒即可翻译。" Style="{StaticResource Caption}"/></Grid>
 </Grid>
</Window>

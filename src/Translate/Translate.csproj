<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/translate.ico</ApplicationIcon>
    <AssemblyName>Translate</AssemblyName>
    <RootNamespace>Translate</RootNamespace>
    <Description>简洁的 Windows 大模型划词翻译工具</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/translate.ico" />
    <InternalsVisibleTo Include="Translate.Tests" />
  </ItemGroup>
</Project>
